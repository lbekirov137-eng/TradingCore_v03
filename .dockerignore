# Виртуальное окружение: 200+ МБ, и это Windows-venv — в Linux-контейнере
# он не только бесполезен, но и сломан (бинарники не той платформы).
# Зависимости ставятся внутри образа через `pip install -r requirements.txt`.
.venv/
venv/
ENV/

# История git не нужна в рантайм-образе.
# ПРИМЕЧАНИЕ: из-за этого .git/HEAD недоступен внутри контейнера, поэтому
# paper_forward_journal.resolve_code_commit_hash() возьмёт commit hash из
# переменной RAILWAY_GIT_COMMIT_SHA, которую Railway передаёт автоматически.
.git/
.gitignore

# Локальное состояние рантайма — НЕ должно попадать в образ, иначе свежий
# деплой стартует с чужими paper-позициями/ордерами/kill-switch состоянием.
state/

# Загруженные рыночные данные и артефакты бэктестов (десятки МБ).
data/
reports/

# Секреты — на всякий случай, даже если файла нет в репозитории.
.env

# Python-мусор
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.hypothesis/

# Редакторы / ОС
.vscode/
.idea/
.DS_Store
Thumbs.db

# Логи
*.log
