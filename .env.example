# TradingCore — пример конфигурации окружения.
#
# Скопируйте в `.env` для локального запуска:
#     cp .env.example .env
# Для Railway — задайте эти же переменные в Variables проекта,
# НЕ через .env файл (Railway передаёт переменные напрямую в контейнер).
#
# Файл `.env` добавлен в .gitignore и НИКОГДА не должен коммититься.
# Ни один реальный секрет не должен появляться в этом файле-примере.

# ---------------------------------------------------------------------
# Режим торговли — ОБЯЗАТЕЛЬНЫЕ ограничения безопасности
# ---------------------------------------------------------------------
# PAPER — внутренний симулятор, без каких-либо сетевых ордеров (по умолчанию, безопасно)
# DEMO  — официальное Bybit Demo Trading окружение (api-demo.bybit.com)
# LIVE  — ЗАПРЕЩЕНО. Приложение ОТКАЖЕТСЯ ЗАПУСКАТЬСЯ при TRADING_ENVIRONMENT=LIVE.
# Любое другое/опечатанное значение также приводит к отказу запуска (fail-closed).
TRADING_ENVIRONMENT=PAPER

# ЗАПРЕЩЕНО устанавливать в true. Приложение откажется запускаться, если это true.
# Оставьте false или не задавайте эту переменную вовсе.
LIVE_TRADING=false

PAPER_TRADING=true

# Разрешены только публичные market-data эндпоинты и paper-исполнение,
# даже если TRADING_ENVIRONMENT=DEMO и заданы demo-ключи.
DEMO_ONLY=true

# ---------------------------------------------------------------------
# Фоновый PAPER-монитор (opt-in)
# ---------------------------------------------------------------------
# Включает непрерывный фоновый paper-цикл внутри процесса uvicorn:
# публичные свечи Binance -> пайплайн -> решение NO_TRADE/TRADE ->
# paper-исполнение -> журнал. Реальные ордера невозможны.
#
# По умолчанию ВЫКЛЮЧЕНО. Без этого флага сервис отвечает на HTTP, но
# не ведёт автономного наблюдения. Для облачного paper-forward запуска
# установите true. Состояние проверяется через GET /monitor/status,
# решения видны в логах по префиксу "PAPER_DECISION".
PAPER_MONITOR_ENABLED=false

# Интервал опроса рынка в секундах (по умолчанию 30). Свеча 5m всё равно
# обрабатывается один раз на закрытие — опрос лишь проверяет её появление.
PAPER_MONITOR_POLL_SECONDS=30

# Каталог файлов состояния и журнала (по умолчанию "data").
# ВАЖНО: в контейнере файловая система ЭФЕМЕРНА и `data/` исключён через
# .dockerignore — файловый журнал НЕ переживает redeploy без volume.
# Durable-журналом в облаке служит stdout (Railway Deploy Logs).
PAPER_DATA_DIR=data

# ---------------------------------------------------------------------
# Bybit Demo Trading (ТОЛЬКО для TRADING_ENVIRONMENT=DEMO)
# ---------------------------------------------------------------------
# Создайте demo-ключи в личном кабинете Bybit в разделе Demo Trading.
# Это НЕ ключи от реального счёта. Никогда не вставляйте сюда
# production-ключи и не включайте право на вывод средств (withdrawal).
# Если ключи не заданы — система работает на публичных market-data
# эндпоинтах (без авторизации), это штатный и безопасный режим.
BYBIT_DEMO_API_KEY=
BYBIT_DEMO_API_SECRET=

# ---------------------------------------------------------------------
# Торговые параметры — безопасные значения по умолчанию
# ---------------------------------------------------------------------
# ПРИМЕЧАНИЕ: symbol/interval/balance ниже используются как значения по
# умолчанию для GET /paper/tick (можно переопределить query-параметром
# при ручном вызове). Они НЕ читаются автоматически как переменные
# окружения текущим кодом — задокументированы здесь для ясности, что
# именно используется по умолчанию.
TRADING_SYMBOL=BTCUSDT
TRADING_INTERVAL=5m
STARTING_BALANCE=1000

# risk_per_trade НЕ является переменной окружения — это осознанное решение
# безопасности. Значение зафиксировано в коде (config/settings.py,
# DEFAULT_RISK_PERCENT=0.1, что равно risk_per_trade=0.001 = 0.1% капитала)
# и покрыто тестами. Требование "0.001 или меньше" выполнено константой,
# а не конфигурацией — так ни одна переменная окружения не может случайно
# увеличить риск на сделку.

# ---------------------------------------------------------------------
# Telegram (опционально, ВЫКЛЮЧЕН по умолчанию)
# ---------------------------------------------------------------------
# Если ОБЕ переменные заданы, ai_observer/telegram_notifier.py выполняет
# РЕАЛЬНЫЙ сетевой запрос к api.telegram.org (это не mock-транспорт).
# Пока хотя бы одна пуста, notifier.configured == False и send() сразу
# возвращает False, не обращаясь к сети, — данные наружу не уходят.
#
# Оставьте пустыми, если не нужен внешний канал уведомлений.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------
# ЗАПРЕЩЁННЫЕ переменные — НЕ добавляйте их ни при каких условиях
# ---------------------------------------------------------------------
# LIVE_TRADING=true                 -- приложение откажется запускаться
# TRADING_ENVIRONMENT=LIVE          -- приложение откажется запускаться
# TRADING_ENVIRONMENT=mainnet       -- нераспознанное значение, отказ запуска
# Любые реальные production API-ключи (не demo) — никогда не используются кодом
# LEVERAGE / MARGIN переменные      -- не поддерживаются, плечо всегда = 1
